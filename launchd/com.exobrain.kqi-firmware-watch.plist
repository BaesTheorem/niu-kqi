<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.exobrain.kqi-firmware-watch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/alexhedtke/.local/bin/mist-launch</string>
		<string>/bin/sh</string>
		<string>/Users/alexhedtke/Documents/niu-kqi/bin/kqi-firmware-watch</string>
	</array>
	<!-- daily at 10:15; launchd runs a missed slot at the next wake -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>10</integer>
		<key>Minute</key>
		<integer>15</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/alexhedtke/Library/Logs/exobrain/kqi-firmware-watch.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/alexhedtke/Library/Logs/exobrain/kqi-firmware-watch.log</string>
	<!-- Login Items shows the job under this app instead of its executable's name;
	     only honored because mist-launch is signed by the same team. -->
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.exobrain.mist-console</string>
	</array>
</dict>
</plist>
